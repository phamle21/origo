# Production settings for compose.prod.yaml. Copy to .env.prod and fill in every empty value.
# Never reuse development passwords or keys. On a platform that runs each image as its own app
# (e.g. Easypanel), give the API, queue and scheduler the "API" section and the web the "Web" section.

# --- Release -----------------------------------------------------------------------------------------
# Image tag to run, e.g. 1.0.0 (pin a version; avoid "latest" in production).
ORIGO_VERSION=1.0.0
# Host ports to put behind your HTTPS reverse proxy.
WEB_PORT=3000
API_PORT=8000

# --- API (Laravel) -----------------------------------------------------------------------------------
APP_NAME=Origo
# Generate once: docker run --rm ghcr.io/phamle21/origo-api:<version> php artisan key:generate --show
APP_KEY=
# Public address of the API; uploaded screen images are served from it.
APP_URL=https://api.example.com
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
# Apply pending migrations when the API container starts (or run `php artisan origo:install` yourself).
AUTO_MIGRATE=false

LOG_LEVEL=warning

# Database. With compose.prod.yaml the host is the bundled `postgres` service; elsewhere set DB_HOST.
DB_DATABASE=origo
DB_USERNAME=origo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_PASSWORD=

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Public address of the web app.
FRONTEND_URL=https://origo.example.com
SANCTUM_STATEFUL_DOMAINS=origo.example.com

# Private hosts the renderer may open (all private addresses are blocked by default), comma separated.
RENDERER_ALLOWED_PRIVATE_HOSTS=

# --- Web (Nuxt) --------------------------------------------------------------------------------------
# With compose.prod.yaml the web reaches the API at http://api; elsewhere set NUXT_API_BASE_URL to the
# API's internal address.
# Alerts for server errors: turn one channel on and give its webhook (keep it secret).
NUXT_ERROR_NOTIFY_ENABLED=false
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_ENABLED=false
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_WEBHOOK_URL=
NUXT_ERROR_NOTIFY_SLACK_ENABLED=false
NUXT_ERROR_NOTIFY_SLACK_WEBHOOK_URL=
