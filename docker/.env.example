# Docker Compose settings for the development stack (compose.yaml). Copy to .env.

# Match your user (`id -u`, `id -g`) so files created in the containers stay editable.
UID=1000
GID=1000

# Versions
PHP_VERSION=8.5
NODE_VERSION=24.14.0
POSTGRES_VERSION=18

# Host ports
API_PORT=8310
WEB_PORT=3310
POSTGRES_PORT=5442
REDIS_PORT=6389
MAILPIT_PORT=8035
STORYBOOK_PORT=6306

# Local database (development only)
POSTGRES_DB=origo
POSTGRES_USER=origo
POSTGRES_PASSWORD=origo_local_only

# Private hosts the renderer may open (all private addresses are blocked by default), comma separated.
RENDERER_ALLOWED_PRIVATE_HOSTS=
