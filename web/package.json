{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:notify": "NOTIFY_SMOKE=1 vitest run test/integration/server/notifications",
    "type-check": "nuxt prepare && vue-tsc --build",
    "analyze": "yarn nuxi analyze",
    "project-info": "yarn nuxi info",
    "verify:core": "yarn format:check && yarn lint && yarn type-check && yarn build",
    "verify:test": "yarn test:unit",
    "verify:coverage": "yarn test:coverage",
    "verify:storybook": "yarn build-storybook",
    "verify:quick": "yarn format:check && yarn lint && yarn type-check && yarn verify:test",
    "verify": "yarn verify:core && yarn verify:coverage && yarn verify:storybook",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "0.11.3",
    "nuxt": "4.5.2",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.1.0",
    "@pinia/testing": "1.0.3",
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/addon-themes": "10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/vue3-vite": "10.5.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/compiler-dom": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "husky": "9.1.7",
    "jsdom": "29.1.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "rolldown": "1.2.1",
    "sass": "1.102.0",
    "storybook": "10.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unplugin-auto-import": "21.1.0",
    "vite": "8.2.0",
    "vite-svg-loader": "5.1.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "engines": {
    "node": "24.14.0"
  },
  "engineStrict": true,
  "packageManager": "yarn@4.13.0"
}
