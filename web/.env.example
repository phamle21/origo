NUXT_PUBLIC_APP_NAME=Origo
NUXT_PUBLIC_ERROR_REPORTING_ENABLED=true

# Backend API settings (server-only; any stack behind this URL)
NUXT_API_BASE_URL=
NUXT_API_TIMEOUT_MILLISECONDS=10000

# Server logging channel: daily / stdout / stack (daily and stdout)
NUXT_LOGGING_CHANNEL=daily
# Minimum recorded level: debug < info < warn < error < fatal.
NUXT_LOGGING_LEVEL=warn
# Daily-file retention in UTC days. Values are clamped to 1-365; non-numeric values fall back to 30.
NUXT_LOGGING_RETENTION_DAYS=30

# Error notification settings
NUXT_ERROR_NOTIFY_ENABLED=false

# Google Chat alerts for failed requests
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_ENABLED=false
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_WEBHOOK_URL=
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_DEDUP_WINDOW_SECONDS=300
NUXT_ERROR_NOTIFY_GOOGLE_CHAT_AVATAR_URL=

# Slack alerts for failed requests (incoming webhook)
NUXT_ERROR_NOTIFY_SLACK_ENABLED=false
NUXT_ERROR_NOTIFY_SLACK_WEBHOOK_URL=
NUXT_ERROR_NOTIFY_SLACK_DEDUP_WINDOW_SECONDS=300
